+++ b/src/modules/graphics/wrap_GraphicsCanvasConstructor.cpp
@@ -0,0 +1,84 @@
+/** Copyright (c) 2006-2023 LOVE Development Team. */
+#include "wrap_GraphicsCanvasConstructor.h"
+
+#include "common/Module.h"
+#include "common/pixelformat.h"
+#include "wrap_Canvas.h"
+#include "wrap_GraphicsInfo.h"
+
+namespace love::graphics
+{
+
+int w_newCanvas(lua_State *L)
+{
+	auto *module = luax_getmodule(L, Module::M_GRAPHICS);
+	auto *command = dynamic_cast<GraphicsCanvasCommand *>(module);
+	auto *info = dynamic_cast<GraphicsInfoCommand *>(module);
+	if (!command || !info || !info->isCreated())
+		return luaL_error(L, "love.graphics cannot function without a window!");
+
+	Canvas::Settings settings;
+	// Love 11.5 uses LuaJIT's integer conversion here, which truncates finite
+	// numeric values. Preserve that behavior on Lua 5.5.
+	settings.width = static_cast<int>(luaL_optnumber(L, 1, info->getWidth()));
+	settings.height = static_cast<int>(luaL_optnumber(L, 2, info->getHeight()));
+	settings.dpiScale = static_cast<float>(info->getDPIScale());
+
+	int startIndex = 3;
+	if (lua_isnumber(L, 3))
+	{
+		settings.layers = static_cast<int>(luaL_checknumber(L, 3));
+		settings.type = TEXTURE_2D_ARRAY;
+		startIndex = 4;
+	}
+
+	if (!lua_isnoneornil(L, startIndex))
+	{
+		luax_checktablefields<Canvas::SettingType>(L, startIndex,
+			"canvas setting name", Canvas::getConstant);
+		settings.dpiScale = static_cast<float>(luax_numberflag(L, startIndex,
+			Canvas::getConstant(Canvas::SETTING_DPI_SCALE), settings.dpiScale));
+		settings.msaa = luax_intflag(L, startIndex,
+			Canvas::getConstant(Canvas::SETTING_MSAA), settings.msaa);
+
+		lua_getfield(L, startIndex, Canvas::getConstant(Canvas::SETTING_FORMAT));
+		if (!lua_isnoneornil(L, -1))
+		{
+			const char *value = luaL_checkstring(L, -1);
+			if (!getConstant(value, settings.format))
+				return luax_enumerror(L, "pixel format", value);
+		}
+		lua_pop(L, 1);
+
+		lua_getfield(L, startIndex, Canvas::getConstant(Canvas::SETTING_TYPE));
+		if (!lua_isnoneornil(L, -1))
+		{
+			const char *value = luaL_checkstring(L, -1);
+			if (!Texture::getConstant(value, settings.type))
+				return luax_enumerror(L, "texture type", Texture::getConstants(settings.type), value);
+		}
+		lua_pop(L, 1);
+
+		lua_getfield(L, startIndex, Canvas::getConstant(Canvas::SETTING_READABLE));
+		if (!lua_isnoneornil(L, -1)) settings.readable = OptionalBool(luax_checkboolean(L, -1));
+		lua_pop(L, 1);
+
+		lua_getfield(L, startIndex, Canvas::getConstant(Canvas::SETTING_MIPMAPS));
+		if (!lua_isnoneornil(L, -1))
+		{
+			const char *value = luaL_checkstring(L, -1);
+			if (!Canvas::getConstant(value, settings.mipmaps))
+				return luax_enumerror(L, "Canvas mipmap mode",
+					Canvas::getConstants(settings.mipmaps), value);
+		}
+		lua_pop(L, 1);
+	}
+
+	Canvas *canvas = nullptr;
+	luax_catchexcept(L, [&](){ canvas = command->newCanvas(settings); });
+	luax_pushtype(L, canvas);
+	canvas->release();
+	return 1;
+}
+
+}
