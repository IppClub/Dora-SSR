+/** Copyright (c) 2006-2023 LOVE Development Team. */
+#include "wrap_GraphicsPrimitives.h"
+
+#include "common/Module.h"
+
+#include <cstring>
+
+namespace love::graphics
+{
+
+static GraphicsPrimitivesCommand *primitiveCommand(lua_State *L)
+{
+	auto *module = luax_getmodule(L, Module::M_GRAPHICS);
+	auto *command = dynamic_cast<GraphicsPrimitivesCommand *>(module);
+	if (!command)
+		luaL_error(L, "love.graphics has no state-local primitives command adapter");
+	return command;
+}
+
+static GraphicsPrimitivesCommand::DrawMode checkDrawMode(lua_State *L, int index)
+{
+	const char *value = luaL_checkstring(L, index);
+	if (strcmp(value, "line") == 0) return GraphicsPrimitivesCommand::DrawMode::Line;
+	if (strcmp(value, "fill") == 0) return GraphicsPrimitivesCommand::DrawMode::Fill;
+	luax_enumerror(L, "draw mode", std::vector<std::string>{"line", "fill"}, value);
+	return GraphicsPrimitivesCommand::DrawMode::Line;
+}
+
+static GraphicsPrimitivesCommand::ArcMode checkArcMode(lua_State *L, int index)
+{
+	const char *value = luaL_checkstring(L, index);
+	if (strcmp(value, "open") == 0) return GraphicsPrimitivesCommand::ArcMode::Open;
+	if (strcmp(value, "closed") == 0) return GraphicsPrimitivesCommand::ArcMode::Closed;
+	if (strcmp(value, "pie") == 0) return GraphicsPrimitivesCommand::ArcMode::Pie;
+	luax_enumerror(L, "arc mode", std::vector<std::string>{"open", "closed", "pie"}, value);
+	return GraphicsPrimitivesCommand::ArcMode::Pie;
+}
+
+static std::vector<Vector2> checkVertexList(lua_State *L, int start,
+	int minimumVertices, const char *minimumError)
+{
+	int components = lua_gettop(L) - start + 1;
+	const bool table = components == 1 && lua_istable(L, start);
+	if (table) components = static_cast<int>(luax_objlen(L, start));
+	if (components % 2 != 0)
+		luaL_error(L, "Number of vertex components must be a multiple of two");
+	const int count = components / 2;
+	if (count < minimumVertices) luaL_error(L, "%s", minimumError);
+	std::vector<Vector2> vertices(static_cast<size_t>(count));
+	for (int i = 0; i < count; ++i)
+	{
+		if (table)
+		{
+			lua_rawgeti(L, start, i * 2 + 1);
+			lua_rawgeti(L, start, i * 2 + 2);
+			vertices[static_cast<size_t>(i)] = {luax_checkfloat(L, -2), luax_checkfloat(L, -1)};
+			lua_pop(L, 2);
+		}
+		else
+			vertices[static_cast<size_t>(i)] = {luax_checkfloat(L, start + i * 2),
+				luax_checkfloat(L, start + i * 2 + 1)};
+	}
+	return vertices;
+}
+
+int w_points(lua_State *L)
+{
+	const int argc = lua_gettop(L);
+	const bool table = argc == 1 && lua_istable(L, 1);
+	const int entries = table ? static_cast<int>(luax_objlen(L, 1)) : argc;
+	bool tableOfTables = false;
+	if (table && entries > 0)
+	{
+		lua_rawgeti(L, 1, 1);
+		tableOfTables = lua_istable(L, -1);
+		lua_pop(L, 1);
+	}
+	if (!tableOfTables && entries % 2 != 0)
+		return luaL_error(L, "Number of vertex components must be a multiple of two");
+	const int count = tableOfTables ? entries : entries / 2;
+	std::vector<Vector2> positions(static_cast<size_t>(count));
+	std::vector<Colorf> colors;
+	if (tableOfTables) colors.resize(static_cast<size_t>(count));
+	for (int i = 0; i < count; ++i)
+	{
+		if (tableOfTables)
+		{
+			lua_rawgeti(L, 1, i + 1);
+			lua_rawgeti(L, -1, 1);
+			lua_rawgeti(L, -2, 2);
+			positions[static_cast<size_t>(i)] = {luax_checkfloat(L, -2), luax_checkfloat(L, -1)};
+			lua_pop(L, 2);
+			Colorf color {1, 1, 1, 1};
+			float *components[] = {&color.r, &color.g, &color.b, &color.a};
+			for (int component = 0; component < 4; ++component)
+			{
+				lua_rawgeti(L, -1, component + 3);
+				*components[component] = static_cast<float>(luax_optnumberclamped01(L, -1, 1.0));
+				lua_pop(L, 1);
+			}
+			colors[static_cast<size_t>(i)] = color;
+			lua_pop(L, 1);
+		}
+		else if (table)
+		{
+			lua_rawgeti(L, 1, i * 2 + 1);
+			lua_rawgeti(L, 1, i * 2 + 2);
+			positions[static_cast<size_t>(i)] = {luax_checkfloat(L, -2), luax_checkfloat(L, -1)};
+			lua_pop(L, 2);
+		}
+		else
+			positions[static_cast<size_t>(i)] = {luax_checkfloat(L, i * 2 + 1),
+				luax_checkfloat(L, i * 2 + 2)};
+	}
+	luax_catchexcept(L, [&](){ primitiveCommand(L)->points(positions, colors); });
+	return 0;
+}
+
+int w_line(lua_State *L)
+{
+	if (lua_type(L, 1) != LUA_TTABLE && lua_type(L, 1) != LUA_TNUMBER)
+		return luax_typerror(L, 1, "table or number");
+	auto vertices = checkVertexList(L, 1, 2, "Need at least two vertices to draw a line.");
+	luax_catchexcept(L, [&](){ primitiveCommand(L)->polyline(vertices); });
+	return 0;
+}
+
+int w_rectangle(lua_State *L)
+{
+	const auto mode = checkDrawMode(L, 1);
+	const float x = luax_checkfloat(L, 2), y = luax_checkfloat(L, 3);
+	const float width = luax_checkfloat(L, 4), height = luax_checkfloat(L, 5);
+	const float radiusX = static_cast<float>(luaL_optnumber(L, 6, 0));
+	const float radiusY = static_cast<float>(luaL_optnumber(L, 7, radiusX));
+	const int points = lua_isnoneornil(L, 8) ? -1 : static_cast<int>(luaL_checkinteger(L, 8));
+	luax_catchexcept(L, [&](){ primitiveCommand(L)->rectangle(mode, x, y, width, height,
+		radiusX, radiusY, points); });
+	return 0;
+}
+
+int w_circle(lua_State *L)
+{
+	const auto mode = checkDrawMode(L, 1);
+	const float x = luax_checkfloat(L, 2), y = luax_checkfloat(L, 3), radius = luax_checkfloat(L, 4);
+	const int points = lua_isnoneornil(L, 5) ? -1 : static_cast<int>(luaL_checkinteger(L, 5));
+	luax_catchexcept(L, [&](){ primitiveCommand(L)->circle(mode, x, y, radius, points); });
+	return 0;
+}
+
+int w_ellipse(lua_State *L)
+{
+	const auto mode = checkDrawMode(L, 1);
+	const float x = luax_checkfloat(L, 2), y = luax_checkfloat(L, 3);
+	const float radiusX = luax_checkfloat(L, 4);
+	const float radiusY = static_cast<float>(luaL_optnumber(L, 5, radiusX));
+	const int points = lua_isnoneornil(L, 6) ? -1 : static_cast<int>(luaL_checkinteger(L, 6));
+	luax_catchexcept(L, [&](){ primitiveCommand(L)->ellipse(mode, x, y, radiusX, radiusY, points); });
+	return 0;
+}
+
+int w_arc(lua_State *L)
+{
+	const auto drawMode = checkDrawMode(L, 1);
+	auto arcMode = GraphicsPrimitivesCommand::ArcMode::Pie;
+	int start = 2;
+	if (lua_type(L, 2) == LUA_TSTRING) { arcMode = checkArcMode(L, 2); start = 3; }
+	const float x = luax_checkfloat(L, start), y = luax_checkfloat(L, start + 1);
+	const float radius = luax_checkfloat(L, start + 2);
+	const float angle1 = luax_checkfloat(L, start + 3), angle2 = luax_checkfloat(L, start + 4);
+	const int points = lua_isnoneornil(L, start + 5) ? -1
+		: static_cast<int>(luaL_checkinteger(L, start + 5));
+	luax_catchexcept(L, [&](){ primitiveCommand(L)->arc(drawMode, arcMode, x, y, radius,
+		angle1, angle2, points); });
+	return 0;
+}
+
+int w_polygon(lua_State *L)
+{
+	const auto mode = checkDrawMode(L, 1);
+	auto vertices = checkVertexList(L, 2, 3, "Need at least three vertices to draw a polygon");
+	luax_catchexcept(L, [&](){ primitiveCommand(L)->polygon(mode, vertices); });
+	return 0;
+}
+
+}
