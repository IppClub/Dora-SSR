--- /dev/null
+++ b/src/modules/graphics/wrap_GraphicsFontConstructor.cpp
@@ -0,0 +1,72 @@
+/** Copyright (c) 2006-2023 LOVE Development Team. */
+#include "wrap_GraphicsFontConstructor.h"
+
+#include "common/Module.h"
+#include "font/wrap_Rasterizer.h"
+#include "wrap_Font.h"
+#include "wrap_GraphicsFontState.h"
+
+namespace love::graphics
+{
+
+static GraphicsFontConstructorCommand *fontConstructorCommand(lua_State *L)
+{
+	auto *module = luax_getmodule(L, Module::M_GRAPHICS);
+	auto *command = dynamic_cast<GraphicsFontConstructorCommand *>(module);
+	if (!command) luaL_error(L, "love.graphics has no state-local Font factory");
+	return command;
+}
+
+static Font *newFontFromRasterizer(lua_State *L, const char *conversion)
+{
+	if (!luax_istype(L, 1, love::font::Rasterizer::type))
+	{
+		std::vector<int> indices;
+		for (int index = 1; index <= lua_gettop(L); ++index) indices.push_back(index);
+		luax_convobj(L, indices, "font", conversion);
+	}
+	auto *rasterizer = luax_checktype<love::font::Rasterizer>(L, 1);
+	Font *font = nullptr;
+	luax_catchexcept(L, [&](){ font = fontConstructorCommand(L)->newFont(rasterizer); });
+	return font;
+}
+
+int w_newFont(lua_State *L)
+{
+	Font *font = nullptr;
+	if (lua_gettop(L) <= 1 && (lua_isnoneornil(L, 1) || lua_type(L, 1) == LUA_TNUMBER))
+	{
+		const lua_Number value = luaL_optnumber(L, 1, 12);
+		if (!std::isfinite(value) || value < std::numeric_limits<int>::min()
+			|| value > std::numeric_limits<int>::max())
+			return luaL_argerror(L, 1, "number is outside the integer range");
+		const int size = static_cast<int>(value);
+		luax_catchexcept(L, [&](){ font = fontConstructorCommand(L)->newDefaultFont(size); });
+	}
+	else font = newFontFromRasterizer(L, "newRasterizer");
+	luax_pushtype(L, font);
+	font->release();
+	return 1;
+}
+
+int w_newImageFont(lua_State *L)
+{
+	if (!luax_istype(L, 1, love::font::Rasterizer::type))
+		luaL_checktype(L, 2, LUA_TSTRING);
+	Font *font = newFontFromRasterizer(L, "newImageRasterizer");
+	luax_pushtype(L, font);
+	font->release();
+	return 1;
+}
+
+int w_setNewFont(lua_State *L)
+{
+	const int results = w_newFont(L);
+	auto *module = luax_getmodule(L, Module::M_GRAPHICS);
+	auto *state = dynamic_cast<GraphicsFontStateCommand *>(module);
+	if (!state) return luaL_error(L, "love.graphics has no state-local Font state adapter");
+	state->setFont(luax_checkfont(L, -1));
+	return results;
+}
+
+}
