+#ifndef LOVE_WINDOW_WINDOW_H
+#define LOVE_WINDOW_WINDOW_H
+
+// LOVE
+#include "common/Module.h"
+#include "common/StringMap.h"
+#include "common/math.h"
+#include "common/Optional.h"
+#include "image/ImageData.h"
