# Generated package paths. Keep these values unless the package is installed elsewhere.
STUDIO_WEB_DIR=/opt/dora-studio/current/web
STUDIO_AGENT_SUPPORT_DIR=/opt/dora-studio/current/agent-support
STUDIO_AGENT_ENGINE_DIR=/opt/dora-studio/current/agent-engine
STUDIO_RUNTIME_DIR=/opt/dora-studio/current/runtime

# Public HTTPS origins baked into the Web application by studio-macos.sh.
STUDIO_PUBLIC_ORIGIN=__STUDIO_PUBLIC_ORIGIN__
STUDIO_AGENT_HOST_ORIGIN=__STUDIO_AGENT_HOST_ORIGIN__

# The service listens on three origins so untrusted games and the Agent host do
# not share the authenticated Studio origin.
STUDIO_API_HOST=0.0.0.0
STUDIO_API_PORT=8899
STUDIO_AGENT_HOST_PORT=8900
STUDIO_RUNTIME_PORT=8901

# Persistent state and stable encryption key. The installer generates the key
# for a new installation; never regenerate it after encrypted model keys exist.
STUDIO_DB_PATH=/var/lib/dora-studio/studio.db
STUDIO_SECRET_KEY=__GENERATE_ON_INSTALL__

# Install a certificate readable by the dora-studio service account. The same
# certificate may cover all three origins, or place the service behind a TCP/TLS
# proxy that preserves these HTTPS origins.
STUDIO_TLS_CERT=/etc/dora-studio/tls/fullchain.pem
STUDIO_TLS_KEY=/etc/dora-studio/tls/privkey.pem

# Optional Base64 JSON provider catalog. Empty keeps the built-in provider IDs
# but does not configure an outbound shared-model endpoint.
STUDIO_PROVIDER_ENDPOINTS=
# STUDIO_PROVIDER_CA_CERT=/etc/dora-studio/provider-ca.pem
