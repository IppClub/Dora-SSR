{
  "name": "dora-studio",
  "version": "1.10.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/build-production.mjs",
    "build:agent-host": "node scripts/build-agent-host.mjs",
    "build:server": "go build -trimpath -o build/bin/dora-studio-server ./cmd/studio-server",
    "test:server": "go test -race ./...",
    "server": "go run ./cmd/studio-server",
    "invite:bootstrap": "go run ./cmd/issue-bootstrap-invite",
    "test:agent-followup": "node scripts/test-agent-followup.mjs",
    "test:agent-followup:user": "node scripts/test-agent-followup.mjs --user-test",
    "test:agent-vision-input": "node scripts/test-agent-vision-input.mjs"
  },
  "devDependencies": {
    "@dora-studio/tstl": "workspace:*",
    "esbuild": "0.28.0",
    "typescript": "5.9.3"
  }
}
