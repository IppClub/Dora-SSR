_ENV = Dora
import global

export currentVersion = 1

export check = ->
	unless DB\isReady!
		return {
			ok: false
			kind: "open"
			error: DB\getOpenError!
		}
	rows = DB\query "SELECT version FROM DoraSchemaMeta WHERE component = 'main' LIMIT 1"
	version = rows and rows[1] and rows[1][1]
	unless type(version) == "number"
		return {
			ok: false
			kind: "metadata"
		}
	if version > currentVersion
		return {
			ok: false
			kind: "newer"
			:version
		}
	unless version == currentVersion
		return {
			ok: false
			kind: "migration"
			:version
		}
	{
		ok: true
		:version
	}
