import "Dora" as :App, :Content, :HttpServer, :Path, :json, :wait
import "Script.Dev.ExportPolicy" as :projectFileAllowed
import "Script.Dev.GodotDependency" as :needsGodot

runtimeRoots = {"Audio", "Font", "Image", "Shader", "Script/Lib", "LICENSES", "GodotRuntimeNotices", "gamecontrollerdb.txt"}
entryExtensions = {"lua", "yue", "tl", "xml", "wasm"}

fail = (zh, en) -> error App.locale\match("^zh") and zh or en, 0

copyFile = (src, dst) ->
	Content\mkdir Path\getPath dst
	unless Content\copyAsync src, dst
		fail "复制失败：#{src}", "Could not copy: #{src}"

copyProject = (root, folder) ->
	-- Analyze the published files, without hidden workspace or Remix metadata.
	for file in *Content\getAllFiles root
		if projectFileAllowed file
			copyFile Path(root, file), Path(folder, file)
	needsGodot folder

projectId = (root) ->
	metadata = Path root, ".dora"
	file = Path metadata, "native-export-id"
	if Content\exist file
		id = Content\load file
		return id if id and #id == 32 and id\match "^[0-9a-f]+$"
		fail "项目导出 ID 无效", "Invalid project export ID"
	id = (require "dora.new_game_id")!
	Content\mkdir metadata
	unless Content\save file, id
		fail "无法保存项目导出 ID", "Could not save the project export ID"
	id

bootstrap = (entry) -> [[
local Dora = require("Dora")
local Content, Path = Dora.Content, Dora.Path
local root = Path(Content.assetPath, "Game")
local paths = {root, Path(Content.assetPath, "Script", "Lib"), Content.assetPath}
local scripts = Path(root, "Script")
if Content:exist(scripts) then table.insert(paths, 1, scripts) end
Content.searchPaths = paths
local run = require(Path(root, ]] .. string.format("%q", entry) .. [[))
if type(run) == "function" then run() end
]]

export prepareGame = (root, fileName, assets) ->
	entry = Path\getRelative(fileName, root)\gsub "\\", "/"
	unless projectFileAllowed entry
		fail "游戏入口必须在项目内", "The game entry must be inside the project"
	runnable = for ext in *entryExtensions
		break true if Content\exist Path(root, "#{entry}.#{ext}")
	unless runnable
		fail "请先在 IDE 中编译游戏", "Build the game in the IDE first"
	useGodot = copyProject root, Path(assets, "Game")
	Content\mkdir Path assets, "Script"
	unless Content\save Path(assets, "Script", "init.lua"), bootstrap(entry)
		fail "无法写入游戏入口", "Could not write the game entry"

	useGodot

export resolveTemplate = (target) ->
	:resolveExportTemplate = require "Script.Dev.ExportTemplate"
	local result
	resolveExportTemplate target, (value) -> result = value
	wait -> result ~= nil
	error result.message, 0 unless result.folder
	result.folder

export exportPackage = (format, root, entry, stage, signing) ->
	import "dora.game_package" as packageBuilder
	assets = Path stage, "assets"
	unless Content\mkdir assets
		fail "无法准备游戏资源", "Could not prepare game assets"
	options = { :format, :assets }
	if format == "android"
		options.needsGodot = prepareGame root, entry, assets
		version = App.version\match "^(%d+%.%d+%.%d+)%.%d+$"
		options.template = Path resolveTemplate("android"), "dora-ssr-v#{version}-android.apk"
		options.policy = Content\load Path Content.assetPath, "Script", "Dev", "ExportPolicy.json"
		options.game = signing.game
		options.password = signing.password
		options.key = signing.key
		options.output = Path stage, "game.apk"
	else
		options.needsGodot = copyProject root, assets
		options.www = HttpServer.wwwPath
		options.output = Path stage, "game.zip"
	local success, result
	done = false
	packageBuilder.run json.encode(options), (ok, value) ->
		success, result = ok, value
		done = true
	wait -> done
	error result, 0 unless success
	Content\remove assets
	options.output, if result ~= "" then result

windowsGodotLibrary = "dora_godot.dll"

windowsRuntimeSource = (useGodot) ->
	if App.platform == "Windows"
		exe = App.executablePath
		godot = Path Path\getPath(exe), windowsGodotLibrary
		if not useGodot or (Content\exist(godot) and not Content\isdir(godot))
			return Content.assetPath, exe
	folder = resolveTemplate "windows-x64"
	folder, Path(folder, "Dora.exe")

export exportWindows = (root, fileName, title, destination) ->
	name = title\gsub('[\\/:*?"<>|%c]', "_")\match "^%s*(.-)%s*$"
	name = "Game" if not name or name == ""
	name = "Game-#{name}"
	if last := utf8.offset name, 61
		name = name\sub 1, last - 1
	archive = Path destination, "#{name}-Windows.zip"
	suffix = 2
	while Content\exist archive
		archive = Path destination, "#{name}-Windows-#{suffix}.zip"
		suffix += 1
	cache = Path Content.appPath, ".native-export"
	stage = Path cache, "stage-#{os.time!}-#{App.rand}"
	assets = Path stage, "game"
	tempZip = Path destination, ".dora-export-#{Path\getName stage}.tmp"
	success, result = pcall ->
		id = projectId root
		unless Content\mkdir assets
			fail "无法创建导出目录", "Could not create the export directory"
		useGodot = prepareGame root, fileName, assets
		assetRoot, exe = windowsRuntimeSource useGodot
		-- Package game runtime dependencies explicitly for both sources.
		if useGodot
			godot = Path Path\getPath(exe), windowsGodotLibrary
			unless Content\exist(godot) and not Content\isdir(godot)
				fail "此项目需要 Godot，请使用包含 Godot 运行库的 Windows 版 Dora 导出", "Use a Windows build of Dora with Godot to export this project."
			copyFile godot, Path(assets, windowsGodotLibrary)
		for item in *runtimeRoots
			src = Path assetRoot, item
			if Content\isdir src
				for file in *Content\getAllFiles src
					continue if item == "Audio" and file == "GeneralUserGS.sf3"
					continue if item == "Image" and file\gsub("\\", "/") == "Mobile/dora-remix-states.png"
					copyFile Path(src, file), Path(assets, item, file)
			elseif Content\exist src
				copyFile src, Path(assets, item)
		copyFile exe, Path assets, "#{name}.exe"
		unless Content\save Path(assets, "dora-game-id"), id
			fail "无法写入游戏标识", "Could not write the game ID"
		unless Content\zipAsync assets, tempZip
			fail "无法创建游戏 ZIP", "Could not create the game ZIP"
		if not Content\exist(archive) and Content\move(tempZip, archive)
			return archive
		fail "无法保存游戏 ZIP", "Could not save the game ZIP"
	Content\remove stage if Content\exist stage
	Content\remove tempZip if Content\exist tempZip
	error result, 0 unless success
	result

export exportAndroid = (root, fileName, title) ->
	dispatch = require "dora.android_game_export"
	stage = Path Content.appPath, ".native-export", "android-#{os.time!}-#{App.rand}"
	success, result = pcall ->
		unless Content\mkdir stage
			fail "无法创建导出目录", "Could not create the export directory"
		useGodot = prepareGame root, fileName, Path(stage, "assets")
		hasTemplate = require "dora.android_has_export_template"
		unless hasTemplate useGodot
			version = App.version\match "^(%d+%.%d+%.%d+)%.%d+$"
			template = resolveTemplate "android"
			copyFile Path(template, "dora-ssr-v#{version}-android.apk"), Path(stage, "template.apk")
		unless dispatch stage, projectId(root), title, useGodot
			fail "无法打开 APK 导出", "Could not open APK export"
	unless success
		Content\remove stage if Content\exist stage
		error result, 0
