Content = Dora.Content
catalogSync = require "Script.Tools.ResourceDownloader.CatalogSync"
mobileCatalog = require "Dev.Mobile.MobileCatalog"

resultPath = "/tmp/dora-mobile-catalog-integration.result"
progressEvents = 0
lastProgress = ""
forceSync = (options) ->
	options.force = true
	catalogSync.syncCatalog options

mobileCatalog.syncMobileCatalog ((message) ->
	progressEvents += 1
	lastProgress = message
), ((success, message) ->
	unless success
		Content\save resultPath, "failed: #{message or 'unknown Catalog sync error'}"
		return
	cached = catalogSync.loadCachedCatalog!
	unless cached.success and cached.snapshot and #cached.snapshot.catalog.resources > 0
		Content\save resultPath, "failed: synchronized Catalog cache is empty"
		return
	unless progressEvents > 0
		Content\save resultPath, "failed: forced Catalog sync emitted no progress"
		return
	Content\save resultPath, "passed: source=#{cached.snapshot.source} resources=#{#cached.snapshot.catalog.resources} progressEvents=#{progressEvents} last=#{lastProgress}"
), forceSync
