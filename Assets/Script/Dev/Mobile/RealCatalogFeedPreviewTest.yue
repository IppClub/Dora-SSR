App = Dora.App
Content = Dora.Content
Size = Dora.Size
sleep = Dora.sleep
thread = Dora.thread
catalog = require "Script.Tools.ResourceDownloader.Catalog"
catalogSync = require "Script.Tools.ResourceDownloader.CatalogSync"
feed = require "Dev.Mobile.Feed"

resultPath = "/tmp/dora-mobile-real-catalog-feed.result"
cached = catalogSync.loadCachedCatalog!
unless cached.success and cached.snapshot
	Content\save resultPath, "failed: #{cached.message or 'Catalog cache unavailable'}"
	return
resources = catalog.getMobileFeedResources cached.snapshot.catalog.resources
unless #resources > 0
	Content\save resultPath, "failed: Catalog contains no mobile Feed resources"
	return
resource = resources[1]

App.winSize = Size 390, 844
thread ->
	sleep 0.4
	host = feed.startMobileFeed {
		getDiscoverEntries: -> {
			{
				id: resource.id
				title: resource.title["zh-Hans"]
				description: resource.description["zh-Hans"]
				kind: "discover"
				bannerFile: resource.bannerPath
			}
		}
		getLocalEntries: -> {}
		onPlay: ->
		onRemix: ->
		prepare: (entry, repairIncomplete, onProgress, onDone) -> onDone false, nil, "preview only"
	}
	sleep 0.8
	screenshot = App\saveScreenshot "/tmp/dora-mobile-real-catalog-feed"
	sleep 0.3
	Content\save resultPath, "passed: source=#{cached.snapshot.source} resource=#{resource.id} banner=#{resource.bannerPath} screenshot=#{screenshot} hostScale=#{host.scaleX},#{host.scaleY}"
