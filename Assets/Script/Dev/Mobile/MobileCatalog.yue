catalogSync = require "Script.Tools.ResourceDownloader.CatalogSync"

export syncMobileCatalog = (onProgress, onDone, operation = catalogSync.syncCatalog, force = false) ->
	success, err = pcall ->
		promise = operation :force, onStatus: (self, status) -> onProgress status.message
		promise\addCallbacks ((_, result) -> onDone result.success and not (force and result.usedCache), result.message), ((_, err) -> onDone false, tostring err)
	onDone false, tostring err unless success
