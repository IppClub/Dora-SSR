_ENV = Dora
import global

Bootstrap = require "Script.Dev.Bootstrap"

installMetadata = ->
	DB\transaction {
		[[CREATE TABLE IF NOT EXISTS DoraSchemaMeta(
			component TEXT PRIMARY KEY,
			version INTEGER NOT NULL
		)]]
		"INSERT OR REPLACE INTO DoraSchemaMeta(component, version) VALUES('main', #{Bootstrap.currentVersion})"
	}

checkIntegrity = ->
	result = DB\query "PRAGMA quick_check"
	result and result[1] and result[1][1] == "ok"

checkLegacySchema = ->
	tables = DB\query "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'Config' LIMIT 1"
	return false unless tables
	return true unless tables[1]
	DB\query "SELECT name, value_num, value_str, value_bool FROM Config LIMIT 0"

migrate = (status) ->
	return false, "database integrity check failed" unless checkIntegrity!
	version = status.version or 0
	while version < Bootstrap.currentVersion
		switch version
			when 0
				return false, "legacy Config schema is incompatible" unless checkLegacySchema!
				return false, "failed to install database schema metadata" unless installMetadata!
				version = 1
			else
				return false, "no migration is available from database schema version #{version}"
	true

rebuild = ->
	ok, detail = DB\recover!
	return false, detail unless ok
	unless installMetadata!
		return false, "database was rebuilt but schema metadata could not be initialized"
	Log "Dora database was rebuilt. Backup: #{detail}" unless detail == ""
	true

export recover = (status) ->
	if status.kind == "newer"
		return false, "database schema version #{status.version} is newer than supported version #{Bootstrap.currentVersion}"
	if status.kind == "metadata" or status.kind == "migration"
		ok, reason = migrate status
		return true if ok
		Warn "database migration failed: #{reason}; rebuilding the database"
	rebuild!
