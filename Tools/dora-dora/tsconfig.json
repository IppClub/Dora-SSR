{
	"compilerOptions": {
		"target": "es6",
		"lib": [
			"dom",
			"dom.iterable",
			"esnext"
		],
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		// Studio and the IDE have separate pnpm installs. Use one React type
		// identity for linked components, including the automatic JSX runtime.
		"paths": {
			"react": ["./node_modules/@types/react"],
			"react/*": ["./node_modules/@types/react/*"]
		},
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"types": [
			"node",
			"react-transition-group"
		],
	},
	"include": [
		"src"
	]
}
