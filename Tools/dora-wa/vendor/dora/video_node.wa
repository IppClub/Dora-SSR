import "runtime"

#wa:import dora videonode_type
func videonode_type() => i32

#wa:import dora videonode_play
func videonode_play(slf: i64)

#wa:import dora videonode_seek
func videonode_seek(slf: i64, seconds: f64)

#wa:import dora videonode_rewind
func videonode_rewind(slf: i64)

#wa:import dora videonode_get_current_time
func videonode_get_current_time(slf: i64) => f64

#wa:import dora videonode_get_duration
func videonode_get_duration(slf: i64) => f64

#wa:import dora videonode_is_playing
func videonode_is_playing(slf: i64) => i32

#wa:import dora videonode_pause
func videonode_pause(slf: i64)

#wa:import dora videonode_resume
func videonode_resume(slf: i64)

#wa:import dora videonode_is_paused
func videonode_is_paused(slf: i64) => i32

#wa:import dora videonode_new
func videonode_new(filename: i64, looped: i32) => i64

type VideoNode :struct{ Sprite }

func VideoNodeFrom(raw: i64) => *VideoNode {
	if raw == 0 {
		return nil
	}
	object := VideoNode{}
	object.raw = &raw
	runtime.SetFinalizer(object.raw, ObjectFinalizer)
	result := &object
	return result
}
func VideoNode.GetTypeId() => i32 {
	return videonode_type()
}
func ObjectAsVideoNode(object: Object) => *VideoNode {
	if object.GetTypeId() == videonode_type() {
		ObjectRetain(object.GetRaw())
		return VideoNodeFrom(object.GetRaw())
	}
	return nil
}

/// Starts or resumes playback; restarts from zero after the end.
func VideoNode.Play() {
	videonode_play(*this.raw)
}

/// Seeks both tracks in seconds, clamped to the duration. Preserves pause; non-finite values are ignored.
func VideoNode.Seek(seconds: f64) {
	videonode_seek(*this.raw, seconds)
}

/// Seeks to zero while preserving the paused state.
func VideoNode.Rewind() {
	videonode_rewind(*this.raw)
}

/// Gets Current playback position in seconds, including while paused or ended.
func VideoNode.GetCurrentTime() => f64 {
	return videonode_get_current_time(*this.raw)
}

/// Gets Total playback duration in seconds, the longer of the video and audio tracks.
func VideoNode.GetDuration() => f64 {
	return videonode_get_duration(*this.raw)
}

/// Gets Whether playback is requested in the running scene and has not paused or ended. Includes buffering.
func VideoNode.IsPlaying() => bool {
	return videonode_is_playing(*this.raw) != 0
}

/// Pauses the video and embedded audio playback.
func VideoNode.Pause() {
	videonode_pause(*this.raw)
}

/// Resumes both tracks; restarts from zero after the end.
func VideoNode.Resume() {
	videonode_resume(*this.raw)
}

/// Gets Whether the video is currently paused.
func VideoNode.IsPaused() => bool {
	return videonode_is_paused(*this.raw) != 0
}

/// Creates a new VideoNode object for playing a video.
///
/// # Arguments
///
/// * `filename` - The path to an Ogg (`.ogv`) file containing a Theora video stream. VideoNode reads it through Dora Content, decodes Theora 4:2:0/4:2:2/4:4:4 in software, and automatically plays an embedded Vorbis track with synchronized pause, resume, and looping.
/// * `looped` - (optional) Whether the video should loop. Default is false.
///
/// # Returns
///
/// * `VideoNode` - The created VideoNode instance. Returns `nil` if creation fails.
func NewVideoNode(filename: string, looped: bool) => *VideoNode {
	raw := videonode_new(ToDoraString(filename), ToDoraBool(looped))
	if raw == 0 {
		return nil
	}
	object := VideoNode{}
	object.raw = &raw
	runtime.SetFinalizer(object.raw, ObjectFinalizer)
	return &object
}
