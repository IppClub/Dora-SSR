func drawnode_draw_sector(slf: i64, center: i64, radius: f32, start_angle: f32, end_angle: f32, fill_color: i32, border_width: f32, border_color: i32)

#wa:import dora drawnode_draw_quadratic_bezier
func drawnode_draw_quadratic_bezier(slf: i64, from: i64, control: i64, to: i64, radius: f32, color: i32)

#wa:import dora drawnode_draw_cubic_bezier
func drawnode_draw_cubic_bezier(slf: i64, from: i64, control_1: i64, control_2: i64, to: i64, radius: f32, color: i32)

#wa:import dora drawnode_draw_polygon
func drawnode_draw_polygon(slf: i64, verts: i64, fill_color: i32, border_width: f32, border_color: i32)

#wa:import dora drawnode_draw_vertices
func drawnode_draw_vertices(slf: i64, verts: i64)

#wa:import dora drawnode_clear
func drawnode_clear(slf: i64)

#wa:import dora drawnode_new
func drawnode_new() => i64

type DrawNode :struct{ Node }

func DrawNodeFrom(raw: i64) => *DrawNode {
	if raw == 0 {
		return nil
	}
	object := DrawNode{}
	object.raw = &raw
	runtime.SetFinalizer(object.raw, ObjectFinalizer)
	result := &object
	return result
}
func DrawNode.GetTypeId() => i32 {
	return drawnode_type()
}
func ObjectAsDrawNode(object: Object) => *DrawNode {
	if object.GetTypeId() == drawnode_type() {
		ObjectRetain(object.GetRaw())
		return DrawNodeFrom(object.GetRaw())
	}
	return nil
}

/// Sets whether to write to the depth buffer when drawing (default is false).
func DrawNode.SetDepthWrite(val: bool) {
	drawnode_set_depth_write(*this.raw, ToDoraBool(val))
}

/// Gets whether to write to the depth buffer when drawing (default is false).
func DrawNode.IsDepthWrite() => bool {
	return drawnode_is_depth_write(*this.raw) != 0
}

/// Sets the blend function for the draw node.
func DrawNode.SetBlendFunc(val: BlendFunc) {
	drawnode_set_blend_func(*this.raw, val.ToValue())
}

/// Gets the blend function for the draw node.
func DrawNode.GetBlendFunc() => BlendFunc {
	return BlendFuncFrom(drawnode_get_blend_func(*this.raw))
}

/// Draws a dot at a specified position with a specified radius and color.
///
/// # Arguments
///
/// * `pos` - The position of the dot.
/// * `radius` - The radius of the dot.
/// * `color` - The color of the dot.
func DrawNode.DrawDot(pos: Vec2, radius: f32, color: Color) {
	drawnode_draw_dot(*this.raw, pos.ToValue(), radius, color.ToARGB())
}

/// Draws a circle at a specified center with a specified radius and color.
///
/// # Arguments
///
/// * `center` - The center of the circle.
/// * `radius` - The radius of the circle.
/// * `color` - The color of the circle.
func DrawNode.DrawCircle(center: Vec2, radius: f32, color: Color) {
	drawnode_draw_circle(*this.raw, center.ToValue(), radius, color.ToARGB())
}

/// Draws a rectangle with an optional border.
///
/// # Arguments
///
/// * `rect` - The rectangle to draw.
/// * `fill_color` - The fill color of the rectangle.
/// * `border_width` - Half of the border width, extending to both sides of the outline.
/// * `border_color` - The color of the border.
func DrawNode.DrawRect(rect: Rect, fill_color: Color, border_width: f32, border_color: Color) {
	drawnode_draw_rect(*this.raw, rect.GetRaw(), fill_color.ToARGB(), border_width, border_color.ToARGB())
}

/// Draws a filled ellipse at a specified center.
///
/// # Arguments
///
/// * `center` - The center of the ellipse.
/// * `radius_x` - The horizontal radius of the ellipse.
/// * `radius_y` - The vertical radius of the ellipse.
/// * `color` - The color of the ellipse.
func DrawNode.DrawEllipse(center: Vec2, radius_x: f32, radius_y: f32, color: Color) {
	drawnode_draw_ellipse(*this.raw, center.ToValue(), radius_x, radius_y, color.ToARGB())
}

/// Draws a line segment between two points with a specified radius and color.
///
/// # Arguments
///
/// * `from` - The starting point of the line.
/// * `to` - The ending point of the line.
/// * `radius` - The radius of the line.
/// * `color` - The color of the line.
func DrawNode.DrawSegment(from: Vec2, to: Vec2, radius: f32, color: Color) {
	drawnode_draw_segment(*this.raw, from.ToValue(), to.ToValue(), radius, color.ToARGB())
}

/// Draws a connected stroke with round caps and miter joins, beveling long miters. Radius is half the width; adjacent duplicates are ignored.
///
/// # Arguments
///
/// * `verts` - The vertices of the polyline.
/// * `radius` - Half of the line width.
/// * `color` - The color of the polyline.
/// * `closed` - Whether to connect the last vertex back to the first.
func DrawNode.DrawPolyline(verts: *[]Vec2, radius: f32, color: Color, closed: bool) {
	drawnode_draw_polyline(*this.raw, ToDoraVec2Buf(verts), radius, color.ToARGB(), ToDoraBool(closed))
}

/// Draws an arc in degrees: zero points along +X and increasing angles turn toward +Y. The signed sweep is limited to one revolution; full circles close without caps. Line radius is half the width.
///
/// # Arguments
///
/// * `center` - The center of the arc.
/// * `radius` - The radius from the center to the arc.
/// * `start_angle` - The starting angle in degrees.
/// * `end_angle` - The ending angle in degrees.
/// * `line_radius` - Half of the line width.
/// * `color` - The color of the arc.
func DrawNode.DrawArc(center: Vec2, radius: f32, start_angle: f32, end_angle: f32, line_radius: f32, color: Color) {
	drawnode_draw_arc(*this.raw, center.ToValue(), radius, start_angle, end_angle, line_radius, color.ToARGB())
}

/// Draws a rounded rectangle. The corner radius is clamped to half the smaller dimension; zero draws a rectangle. Border width is a half width centered on the outline.
func DrawNode.DrawRoundedRect(rect: Rect, corner_radius: f32, fill_color: Color, border_width: f32, border_color: Color) {
	drawnode_draw_rounded_rect(*this.raw, rect.GetRaw(), corner_radius, fill_color.ToARGB(), border_width, border_color.ToARGB())
}

/// Draws a ring with 0 <= innerRadius < outerRadius. Zero inner radius fills the center. Optional centered borders surround both contours; border width is a half width.
func DrawNode.DrawRing(center: Vec2, inner_radius: f32, outer_radius: f32, fill_color: Color, border_width: f32, border_color: Color) {
	drawnode_draw_ring(*this.raw, center.ToValue(), inner_radius, outer_radius, fill_color.ToARGB(), border_width, border_color.ToARGB())
}

/// Draws a filled sector in degrees from +X toward +Y. Signed sweep is limited to one revolution. Full circles omit radial edges; equal angles draw nothing. Border width is a half width.
func DrawNode.DrawSector(center: Vec2, radius: f32, start_angle: f32, end_angle: f32, fill_color: Color, border_width: f32, border_color: Color) {
	drawnode_draw_sector(*this.raw, center.ToValue(), radius, start_angle, end_angle, fill_color.ToARGB(), border_width, border_color.ToARGB())
}

/// Draws a quadratic Bezier stroke with round caps; coincident endpoints close the stroke. Radius is half the width. Adaptive subdivision targets 0.25 local units, with at most 1024 segments.
func DrawNode.DrawQuadraticBezier(from: Vec2, control: Vec2, to: Vec2, radius: f32, color: Color) {
	drawnode_draw_quadratic_bezier(*this.raw, from.ToValue(), control.ToValue(), to.ToValue(), radius, color.ToARGB())
}

/// Draws a cubic Bezier stroke with round caps; coincident endpoints close the stroke. Radius is half the width. Adaptive subdivision targets 0.25 local units, with at most 1024 segments.
func DrawNode.DrawCubicBezier(from: Vec2, control_1: Vec2, control_2: Vec2, to: Vec2, radius: f32, color: Color) {
	drawnode_draw_cubic_bezier(*this.raw, from.ToValue(), control_1.ToValue(), control_2.ToValue(), to.ToValue(), radius, color.ToARGB())
}

/// Draws a simple convex or concave polygon in boundary order with either winding. Self-intersections and holes are unsupported; the border is centered on the outline.
///
/// # Arguments
///
/// * `verts` - The vertices of the polygon.
/// * `fill_color` - The fill color of the polygon.
/// * `border_width` - Half of the border width, extending to both sides of the outline.
/// * `border_color` - The color of the border.
func DrawNode.DrawPolygon(verts: *[]Vec2, fill_color: Color, border_width: f32, border_color: Color) {
	drawnode_draw_polygon(*this.raw, ToDoraVec2Buf(verts), fill_color.ToARGB(), border_width, border_color.ToARGB())
}

/// Draws a set of vertices as triangles, each vertex with its own color.
///
/// # Arguments
///
/// * `verts` - The list of vertices and their colors. Each element is a tuple where the first element is a `Vec2` and the second element is a `Color`.
func DrawNode.DrawVertices(verts: *[]VertexColor) {
	drawnode_draw_vertices(*this.raw, ToDoraVertexColorBuf(verts))
}

/// Clears all previously drawn shapes from the node.
func DrawNode.Clear() {
	drawnode_clear(*this.raw)
}

/// Creates a new DrawNode object.
///
/// # Returns
///
/// * A new `DrawNode` object.
func NewDrawNode() => DrawNode {
	raw := drawnode_new()
	object := DrawNode{}
	object.raw = &raw
	runtime.SetFinalizer(object.raw, ObjectFinalizer)
	return object
}
