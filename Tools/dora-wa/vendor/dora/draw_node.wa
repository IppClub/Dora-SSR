func drawnode_draw_arc(slf: i64, center: i64, radius: f32, start_angle: f32, end_angle: f32, line_radius: f32, color: i32)

#wa:import dora drawnode_draw_rounded_rect
func drawnode_draw_rounded_rect(slf: i64, rect: i64, corner_radius: f32, fill_color: i32, border_width: f32, border_color: i32)

#wa:import dora drawnode_draw_ring
func drawnode_draw_ring(slf: i64, center: i64, inner_radius: f32, outer_radius: f32, fill_color: i32, border_width: f32, border_color: i32)

