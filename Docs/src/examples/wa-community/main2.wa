// 社区示例与美术素材 / Community examples and pixel art: serci_loser

// ===================================================================
// 第 3~4 步：绘制图片 + 存档保存
// 学什么：
//   第 3 步 用图片(背景、僵尸)
//   第 4 步 存档(把状态写进文件,重启后读回来)
// ===================================================================
//
// 和 lua(LÖVE) 的对照：
//   love.graphics.newImage + draw  → dora.NewSpriteWithFile + AddChild
//   love.filesystem.write / read   → dora.Content.Save / Load
//
// 运行后：背景 + 僵尸 + 蓝色方块。
// 点方块：换颜色并保存；点"向右移动"按钮：方块往右走一段。

import "dora"

global squareFill: dora.DrawNode // 方块底色
global square: dora.Node        // 方块节点(第2步创建)
global squareClicked = false    // 方块状态:false=没点过,true=点过
global countLabel: *dora.Label  // 方块上的文字
global saveFile = "wa-tutorial-2-color.txt"    // 存档文件名

// 入口。调用顺序 = 绘制顺序:先挂的在下层,后挂的在上层。
func init {
	saveFile = writablePath(saveFile)
	Step3() // 先画背景、僵尸
	Step2() // 再画方块、按钮
	Step4() // 最后读存档
}

// 第 2 步:方块、文字、点击、按钮。
func Step2() {
	ui := dora.Director.GetUI() // 拿到 2D 界面根节点,之后所有东西都挂它下面

	// ---- 方块 -----------------------------------------------------
	// dora.NewNode():创建一个空节点。它本身看不见,用来当容器(挂子节点)或点击区域。
	square = dora.NewNode()
	// square.SetSize(宽, 高):设置节点矩形的大小。这里 180×180,同时也当作点击区域。
	square.SetSize(dora.NewSize(180, 180)) // dora.NewSize(宽,高):定义一个尺寸
	// dora.NewVec2(x, y):创建一个二维坐标(点)。
	// square.SetAnchor(x, y):设置锚点,即节点矩形上哪个点会落在 SetPosition 的坐标上;
	//   (0.5, 0.5) 表示"中心点"。
	square.SetAnchor(dora.NewVec2(0.5, 0.5))
	// square.SetPosition(x, y):把节点放到指定坐标。
	// DoraSSR 原点在【屏幕中心】,X 向右为正,Y 向上为正,所以 (0,0) 就是正中间。
	// dora.Vec2Zero 是现成的 (0,0) 点。
	square.SetPosition(dora.Vec2Zero)
	// square.SetTouchEnabled(true):打开触摸,这个节点才能收到点击事件。
	square.SetTouchEnabled(true)
	// ui.AddChild(子节点):把子节点挂到父节点下面,这样才会被显示/更新。
	ui.AddChild(square)

	// dora.NewDrawNode():创建一个画板节点,可以往上面画图形。
	squareFill = dora.NewDrawNode()
	// squareFill.DrawRect(矩形, 填充色, 描边宽, 描边色):画一个矩形。
	//   描边宽填 0 表示不要描边。
	// dora.NewRect(左下角坐标, 尺寸):定义一个矩形区域。
	// dora.NewColor(红, 绿, 蓝, 不透明度):各是 0~255 的整数。
	//   dora.ColorTransparent 是"完全透明"的现成颜色。
	// 注意:有尺寸的节点,子节点的坐标原点是它的【左下角】,不是中心!
	//   所以从 (0,0) 画 180×180,正好铺满整个方块。
	squareFill.DrawRect(
		dora.NewRect(dora.NewVec2(0, 0), dora.NewSize(180, 180)),
		dora.NewColor(255, 255, 255, 255),
		0,
		dora.ColorTransparent,
	)
	square.AddChild(squareFill.Node)
	// squareFill.SetColor(颜色):只给方块底色的绘制节点染色。
	//   所以刚才把方块画成白色,这里一染就成蓝色了。
	squareFill.SetColor(dora.NewColor(80, 180, 255, 255))

	// dora.NewLabel(字体名, 字号, 是否SDF):创建一行文字;找不到字体会返回 nil。
	countLabel = dora.NewLabel("sarasa-mono-sc-regular", 40, false)
	if countLabel == nil {
		panic("创建 Label 失败,可能是字体名不对")
	}
	countLabel.SetPosition(dora.NewVec2(90, 90)) // 方块本地坐标的中心
	square.AddChild(countLabel.Node)

	hint := dora.NewLabel("sarasa-mono-sc-regular", 26, false)
	if hint != nil {
		// label.SetText(内容):设置要显示的文字。
		hint.SetText("点方块:换色并保存")
		hint.SetPosition(dora.NewVec2(0, -130))
		ui.AddChild(hint.Node)
	}

	// square.OnTapped(func(touch){...}):注册一个回调,完整点击(按下并松开)后执行。
	square.OnTapped(func(touch: dora.Touch) {
		_ = touch // 这一步用不到触点位置,先标记一下(凹语言要求变量被使用)
		squareClicked = !squareClicked
		applySquareState() // 更新颜色和文字
		saveState()        // 存进文件
	})

	// ---- 按钮:点击把方块向右移动 ---------------------------------
	// makeButton 在文件下面,负责做一个"矩形底 + 文字"的按钮。
	moveBtn := makeButton("向右移动 →", 0, -230)
	ui.AddChild(moveBtn)
	moveBtn.OnTapped(func(touch: dora.Touch) {
		_ = touch
		p := square.GetPosition() // square.GetPosition():读节点当前坐标
		p.X = p.X + 40            // X 加 40 = 往右走 40 个坐标单位
		square.SetPosition(p)
	})

	applySquareState() // 先把方块的初始颜色/文字设好
}

// 第 3 步:绘制图片(背景 + 僵尸)
func Step3() {
	ui := dora.Director.GetUI()
	// dora.App.GetVisualSize():返回当前屏幕的宽高(Size)。
	size := dora.App.GetVisualSize()

	// dora.NewSpriteWithFile(图片路径):用图片文件创建一个精灵(能显示图片)。
	//   文件不存在时返回 nil,所以一定要判断。
	// 注意:文件名是 backgroundpng.png(如果改成了 background.png,这里也要改)。
	bg := dora.NewSpriteWithFile("Image/backgroundpng.png")
	if bg == nil {
		panic("找不到背景图 Image/backgroundpng.png")
	}
	bg.SetSize(size) // 把背景图拉伸成和屏幕一样大
	bg.SetAnchor(dora.NewVec2(0.5, 0.5))
	bg.SetPosition(dora.Vec2Zero)
	ui.AddChild(bg.Node)

	zombie := dora.NewSpriteWithFile("Image/zombie.png")
	if zombie == nil {
		panic("找不到 Image/zombie.png")
	}
	zombie.SetAnchor(dora.NewVec2(0.5, 0.5))
	zombie.SetPosition(dora.NewVec2(240, -60)) // 放在场景右边
	ui.AddChild(zombie.Node)
}

// 第 4 步:存档(读)。
func Step4() {
	loadState()
}

// 做一个按钮:矩形底 + 文字,返回这个节点。
func makeButton(text: string, x: f32, y: f32) => dora.Node {
	btn := dora.NewNode()
	btn.SetSize(dora.NewSize(220, 70))
	btn.SetAnchor(dora.NewVec2(0.5, 0.5))
	btn.SetPosition(dora.NewVec2(x, y))
	btn.SetTouchEnabled(true)

	bg := dora.NewDrawNode()
	bg.DrawRect(
		dora.NewRect(dora.NewVec2(0, 0), dora.NewSize(220, 70)),
		dora.NewColor(210, 210, 210, 255),
		0,
		dora.ColorTransparent,
	)
	btn.AddChild(bg.Node)

	label := dora.NewLabel("sarasa-mono-sc-regular", 28, false)
	if label != nil {
		label.SetText(text)
		label.SetPosition(dora.NewVec2(110, 35)) // 按钮中心(子节点左下角为原点)
		btn.AddChild(label.Node)
	}
	return btn
}

// 按 squareClicked 更新方块颜色和文字。
func applySquareState() {
	if squareClicked {
		squareFill.SetColor(dora.NewColor(255, 150, 70, 255)) // 橙色
		countLabel.SetText("点到了!")
	} else {
		squareFill.SetColor(dora.NewColor(80, 180, 255, 255)) // 蓝色
		countLabel.SetText("点我")
	}
}

// 存档:把状态写进文件("1"=点过,"0"=没点过)。
func saveState() {
	// dora.Content.Save(文件名, 文字内容):把文字写进文件,返回是否成功。
	if squareClicked {
		dora.Content.Save(saveFile, "1")
	} else {
		dora.Content.Save(saveFile, "0")
	}
}

// 读档:如果文件存在就恢复状态。
func loadState() {
	// dora.Content.Exist(文件名):判断文件/目录是否存在。
	// 先判断一下,避免 Load 一个不存在的文件(会报错)。
	if dora.Content.Exist(saveFile) {
		// dora.Content.Load(文件名):读文件里的文字,文件不存在返回 nil。
		loaded := dora.Content.Load(saveFile)
		if loaded != nil && *loaded == "1" {
			squareClicked = true
		} else {
			squareClicked = false
		}
	} else {
		squareClicked = false
	}
	applySquareState()
}

// 用绝对路径让读写指向同一个文件，不依赖资源搜索路径。
func writablePath(filename: string) => string {
	paths := []string{dora.Content.GetWritablePath(), filename}
	return dora.Path.Concat(&paths)
}
