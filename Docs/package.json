{
  "name": "dora-ssr",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.0",
  "scripts": {
    "build:games": "node ../Tools/build-scripts/build_web_gallery.mjs",
		"build:gitee": "pnpm run typecheck && pnpm run build:games && pnpm run update-version && GITEE=1 docusaurus build && node ../Tools/build-scripts/check_web_gallery.mjs build/play ../build/Dora-Demo",
    "docusaurus": "docusaurus",
    "start": "pnpm run update-version && docusaurus start",
    "build": "pnpm run update-version && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "update-version": "node scripts/update-version.js"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-blog": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.2.17",
    "typescript": "^6.0.3",
    "utility-types": "3.11.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=16.14"
  }
}
