# Reproducible Web build toolchain. Rust is a supported minimum; CI may use a newer stable release.
DORA_WEB_EMSCRIPTEN_VERSION=5.0.5
DORA_WEB_RUST_MIN_VERSION=1.85.1
DORA_WEB_RUST_TARGET=wasm32-unknown-emscripten
DORA_WEB_GO_VERSION=1.24.3
DORA_WEB_NODE_VERSION=22.14.0
DORA_WEB_CMAKE_VERSION=3.30.5
